                {"key": "field_gdhe_module_card_link", "label": "Link", "name": "link", "type": "link", "return_format": "array"}
              ]}
            ]
          },
          "layout_gdhe_split_media": {
            "key": "layout_gdhe_split_media",
            "name": "split_media",
            "label": "Split Media",
            "display": "block",
            "sub_fields": [
              {"key": "field_gdhe_module_split_id_v2", "label": "Module ID", "name": "module_id", "type": "text", "readonly": 1},
              {"key": "field_gdhe_module_split_schema_version_v2", "label": "Module Schema Version", "name": "module_schema_version", "type": "text", "default_value": "1.0.0", "readonly": 1},
              {"key": "field_gdhe_module_split_heading", "label": "Heading", "name": "heading", "type": "text", "maxlength": 120},
