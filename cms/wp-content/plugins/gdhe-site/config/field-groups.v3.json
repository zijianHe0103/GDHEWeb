                {"key": "field_gdhe_module_accordion_answer", "label": "Answer", "name": "answer", "type": "wysiwyg", "required": 1, "toolbar": "basic", "media_upload": 0}
              ]}
            ]
          },
          "layout_gdhe_data_table": {
            "key": "layout_gdhe_data_table",
            "name": "data_table",
            "label": "Data Table",
            "display": "block",
            "sub_fields": [
