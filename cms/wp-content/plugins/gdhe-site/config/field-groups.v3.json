    "location": [
      [{"param": "post_type", "operator": "==", "value": "post"}],
      [{"param": "post_type", "operator": "==", "value": "page"}],
      [{"param": "post_type", "operator": "==", "value": "product"}],
      [{"param": "post_type", "operator": "==", "value": "market"}],
      [{"param": "post_type", "operator": "==", "value": "reference"}],
      [{"param": "post_type", "operator": "==", "value": "support_article"}],
      [{"param": "post_type", "operator": "==", "value": "download"}]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": [],
    "active": true,
    "description": "Versioned GDHE English content schema v3 with Forest-aligned product data, stable module identity, and structured relations. Do not edit in the SCF UI.",
    "show_in_rest": 0
