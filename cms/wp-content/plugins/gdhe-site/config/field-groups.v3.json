          "layout_gdhe_rich_text": {
            "key": "layout_gdhe_rich_text",
            "name": "rich_text",
            "label": "Rich Text",
            "display": "block",
            "sub_fields": [
              {"key": "field_gdhe_module_rich_id_v2", "label": "Module ID", "name": "module_id", "type": "text", "readonly": 1},
              {"key": "field_gdhe_module_rich_schema_version_v2", "label": "Module Schema Version", "name": "module_schema_version", "type": "text", "default_value": "1.0.0", "readonly": 1},
              {"key": "field_gdhe_module_rich_heading", "label": "Heading", "name": "heading", "type": "text", "maxlength": 120},
              {"key": "field_gdhe_module_rich_body", "label": "Body", "name": "body", "type": "wysiwyg", "required": 1, "tabs": "all", "toolbar": "basic", "media_upload": 0}
