      },
      {
        "key": "field_gdhe_support_details",
        "label": "Support Details",
        "name": "support_details",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {"key": "field_gdhe_support_goal", "label": "Problem / Goal", "name": "problem_or_goal", "type": "textarea", "required": 1, "maxlength": 500},
          {"key": "field_gdhe_support_instructions", "label": "Instructions", "name": "instructions", "type": "wysiwyg", "required": 1, "toolbar": "basic", "media_upload": 0},
          {"key": "field_gdhe_support_video", "label": "Video URL", "name": "video_url", "type": "url", "maxlength": 500}
        ]
      },
      {
        "key": "field_gdhe_download_details",
        "label": "Download Details",
        "name": "download_details",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {"key": "field_gdhe_download_version", "label": "Document Version", "name": "version", "type": "text", "required": 1, "maxlength": 80},
