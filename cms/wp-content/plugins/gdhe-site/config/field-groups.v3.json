          {"key": "field_gdhe_reference_results", "label": "Results", "name": "results", "type": "repeater", "max": 20, "sub_fields": [{"key": "field_gdhe_reference_result", "label": "Result", "name": "value", "type": "text", "required": 1, "maxlength": 180}]},
