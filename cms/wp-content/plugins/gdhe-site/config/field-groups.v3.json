          },
          "layout_gdhe_accordion": {
            "key": "layout_gdhe_accordion",
            "name": "accordion",
            "label": "Accordion",
            "display": "block",
            "sub_fields": [
              {"key": "field_gdhe_module_accordion_id_v2", "label": "Module ID", "name": "module_id", "type": "text", "readonly": 1},
              {"key": "field_gdhe_module_accordion_schema_version_v2", "label": "Module Schema Version", "name": "module_schema_version", "type": "text", "default_value": "1.0.0", "readonly": 1},
              {"key": "field_gdhe_module_accordion_heading", "label": "Heading", "name": "heading", "type": "text", "maxlength": 120},
              {"key": "field_gdhe_module_accordion_items", "label": "Items", "name": "items", "type": "repeater", "min": 1, "max": 20, "layout": "row", "button_label": "Add item", "sub_fields": [
