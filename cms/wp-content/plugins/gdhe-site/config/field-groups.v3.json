[
  {
    "key": "group_gdhe_content_schema_v3",
    "title": "GDHE Content Schema v3",
    "fields": [
      {
        "key": "field_gdhe_schema_version",
        "label": "Schema Version",
        "name": "schema_version",
        "type": "text",
        "required": 1,
        "default_value": "3.0.0",
        "readonly": 1
      },
      {
        "key": "field_gdhe_template_key",
        "label": "Template Key",
        "name": "template_key",
        "type": "select",
        "required": 1,
        "choices": {
          "standard": "Standard",
          "product": "Product",
          "market": "Market",
          "reference": "Reference",
          "support_article": "Support Article",
          "download": "Download"
        },
        "default_value": "standard",
        "return_format": "value",
        "allow_null": 0,
        "multiple": 0,
        "ui": 1
      },
      {
        "key": "field_gdhe_summary",
        "label": "Summary",
        "name": "summary",
        "type": "textarea",
        "required": 1,
        "maxlength": 320,
        "rows": 4,
        "new_lines": "br"
      },
      {
        "key": "field_gdhe_hero",
        "label": "Hero",
        "name": "hero",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {"key": "field_gdhe_hero_eyebrow", "label": "Eyebrow", "name": "eyebrow", "type": "text", "maxlength": 80},
          {"key": "field_gdhe_hero_heading", "label": "Heading", "name": "heading", "type": "text", "required": 1, "maxlength": 120},
          {"key": "field_gdhe_hero_lead", "label": "Lead", "name": "lead", "type": "textarea", "maxlength": 320, "rows": 4, "new_lines": "br"},
          {"key": "field_gdhe_hero_media", "label": "Media Reference", "name": "media_reference", "type": "image", "return_format": "id", "preview_size": "medium", "library": "all"},
          {"key": "field_gdhe_hero_primary_cta", "label": "Primary CTA", "name": "primary_cta", "type": "link", "return_format": "array"},
          {"key": "field_gdhe_hero_secondary_cta", "label": "Secondary CTA", "name": "secondary_cta", "type": "link", "return_format": "array"}
        ]
      },
      {
        "key": "field_gdhe_relationships",
        "label": "Relationships",
        "name": "relationships",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {"key": "field_gdhe_related_products", "label": "Related Products", "name": "products", "type": "relationship", "post_type": ["product"], "filters": ["search"], "return_format": "id", "max": 50},
          {"key": "field_gdhe_related_markets", "label": "Related Markets", "name": "markets", "type": "relationship", "post_type": ["market"], "filters": ["search"], "return_format": "id", "max": 50},
          {"key": "field_gdhe_related_references", "label": "Related References", "name": "references", "type": "relationship", "post_type": ["reference"], "filters": ["search"], "return_format": "id", "max": 50},
          {"key": "field_gdhe_related_support_articles", "label": "Related Support Articles", "name": "support_articles", "type": "relationship", "post_type": ["support_article"], "filters": ["search"], "return_format": "id", "max": 50},
          {"key": "field_gdhe_related_downloads", "label": "Related Downloads", "name": "downloads", "type": "relationship", "post_type": ["download"], "filters": ["search"], "return_format": "id", "max": 50}
        ]
      },
      {
        "key": "field_gdhe_product_details",
        "label": "Product Details",
        "name": "product_details",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {"key": "field_gdhe_product_model", "label": "Model", "name": "model", "type": "text", "required": 1, "maxlength": 120},
          {"key": "field_gdhe_product_code", "label": "Product Code", "name": "product_code", "type": "text", "required": 1, "maxlength": 80},
          {"key": "field_gdhe_product_positioning", "label": "Positioning", "name": "positioning", "type": "textarea", "maxlength": 320, "rows": 4},
          {"key": "field_gdhe_product_features", "label": "Features", "name": "features", "type": "repeater", "min": 1, "max": 20, "sub_fields": [
            {"key": "field_gdhe_product_feature", "label": "Feature", "name": "value", "type": "text", "required": 1, "maxlength": 180}
          ]},
          {"key": "field_gdhe_product_specs", "label": "Specifications", "name": "specifications", "type": "repeater", "min": 1, "max": 50, "sub_fields": [
            {"key": "field_gdhe_product_spec_key", "label": "Key", "name": "key", "type": "text", "required": 1, "maxlength": 64},
            {"key": "field_gdhe_product_spec_label", "label": "Label", "name": "label", "type": "text", "required": 1, "maxlength": 120},
            {"key": "field_gdhe_product_spec_value", "label": "Value", "name": "value", "type": "text", "required": 1, "maxlength": 240},
            {"key": "field_gdhe_product_spec_unit", "label": "Unit", "name": "unit", "type": "text", "maxlength": 32}
          ]},
          {"key": "field_gdhe_product_article_numbers", "label": "Article / Order Numbers", "name": "article_numbers", "type": "repeater", "min": 1, "max": 30, "sub_fields": [
            {"key": "field_gdhe_product_article_number", "label": "Number", "name": "number", "type": "text", "required": 1, "maxlength": 80},
            {"key": "field_gdhe_product_article_region", "label": "Region", "name": "region", "type": "text", "required": 1, "maxlength": 80}
          ]},
          {"key": "field_gdhe_product_finishes", "label": "Colors / Finishes", "name": "finishes", "type": "repeater", "max": 30, "sub_fields": [
            {"key": "field_gdhe_product_finish_code", "label": "Code", "name": "code", "type": "text", "required": 1, "maxlength": 80},
            {"key": "field_gdhe_product_finish_label", "label": "Label", "name": "label", "type": "text", "required": 1, "maxlength": 120},
            {"key": "field_gdhe_product_finish_color", "label": "Color", "name": "color", "type": "text", "maxlength": 80}
          ]},
          {"key": "field_gdhe_product_installation", "label": "Installation", "name": "installation", "type": "textarea", "required": 1, "maxlength": 500, "rows": 4},
          {"key": "field_gdhe_product_control", "label": "Operating / Control", "name": "control", "type": "textarea", "maxlength": 500, "rows": 4},
          {"key": "field_gdhe_product_compatibility", "label": "Compatibility", "name": "compatibility", "type": "repeater", "max": 30, "sub_fields": [
            {"key": "field_gdhe_product_compatibility_value", "label": "Requirement", "name": "value", "type": "text", "required": 1, "maxlength": 180}
          ]},
          {"key": "field_gdhe_product_gallery", "label": "Gallery", "name": "gallery", "type": "gallery", "return_format": "id", "max": 20},
          {"key": "field_gdhe_product_video", "label": "Video URL", "name": "video_url", "type": "url", "maxlength": 500},
          {"key": "field_gdhe_product_inquiry", "label": "Inquiry CTA", "name": "inquiry_cta", "type": "link", "return_format": "array"}
        ]
      },
      {
        "key": "field_gdhe_market_details",
        "label": "Market Details",
        "name": "market_details",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {"key": "field_gdhe_market_benefits", "label": "Benefits", "name": "benefits", "type": "repeater", "min": 1, "max": 20, "sub_fields": [{"key": "field_gdhe_market_benefit", "label": "Benefit", "name": "value", "type": "text", "required": 1, "maxlength": 180}]},
          {"key": "field_gdhe_market_requirements", "label": "Requirements", "name": "requirements", "type": "repeater", "max": 20, "sub_fields": [{"key": "field_gdhe_market_requirement", "label": "Requirement", "name": "value", "type": "text", "required": 1, "maxlength": 180}]},
          {"key": "field_gdhe_market_cta", "label": "CTA", "name": "cta", "type": "link", "return_format": "array"}
        ]
      },
      {
        "key": "field_gdhe_reference_details",
        "label": "Reference Details",
        "name": "reference_details",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {"key": "field_gdhe_reference_location", "label": "Location", "name": "location", "type": "text", "required": 1, "maxlength": 180},
          {"key": "field_gdhe_reference_challenge", "label": "Challenge", "name": "challenge", "type": "textarea", "required": 1, "maxlength": 500},
