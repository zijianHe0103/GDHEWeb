{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdhe.example/schemas/v2/modules/card-grid.schema.json",
  "type": "object",
  "required": ["id", "type", "schemaVersion", "data"],
  "properties": {
    "id": {"$ref": "../uuid-v4.schema.json"},
    "type": {"const": "card_grid"},
    "schemaVersion": {"const": "1.0.0"},
    "data": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "heading": {"type": "string", "maxLength": 120},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 100},
              "summary": {"type": "string", "maxLength": 240},
              "link": {"$ref": "../link.schema.json"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
