{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdhe.example/schemas/v2/modules/split-media.schema.json",
  "type": "object",
  "required": ["id", "type", "schemaVersion", "data"],
  "properties": {
    "id": {"$ref": "../uuid-v4.schema.json"},
    "type": {"const": "split_media"},
    "schemaVersion": {"const": "1.0.0"},
    "data": {
      "type": "object",
      "required": ["media_reference", "media_position"],
      "properties": {
        "heading": {"type": "string", "maxLength": 120},
        "safeHtml": {"$ref": "../safe-html.schema.json"},
        "media_reference": {"$ref": "../media-reference.schema.json"},
        "media_position": {"enum": ["left", "right"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
