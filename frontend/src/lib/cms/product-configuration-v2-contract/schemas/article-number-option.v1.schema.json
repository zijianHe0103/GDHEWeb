{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdhe.example/schemas/product-configuration/v1/article-number-option.v1.schema.json",
  "title": "GDHE Article Number Option 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["articleNumber", "lengthMeters", "color"],
  "properties": {
    "articleNumber": {
      "type": "string",
      "pattern": "^GDHEPRD[0-9]{6}$"
    },
    "lengthMeters": {
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.1
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
