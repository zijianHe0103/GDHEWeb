{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdhe.example/schemas/product-card/v1/product-card.v1.schema.json",
  "title": "GDHE Product Card 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "model",
    "name",
    "publicPath",
    "image",
    "primaryCategory",
    "series",
    "applications",
    "summary",
    "keyAttributes",
    "lifecycle",
    "action",
    "modifiedAt"
  ],
  "properties": {
    "id": {
      "$ref": "uuid-v4.schema.json"
    },
    "kind": {
      "enum": ["detail_product", "catalog_accessory"]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "publicPath": {
      "oneOf": [
        {
          "$ref": "public-path.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "image": {
      "$ref": "public-protected-media.v1.schema.json"
    },
    "primaryCategory": {
      "$ref": "public-taxonomy-ref.v1.schema.json"
    },
    "series": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "public-taxonomy-ref.v1.schema.json"
      }
    },
    "applications": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "public-taxonomy-ref.v1.schema.json"
      }
    },
    "summary": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 500
    },
    "keyAttributes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "card-attribute.v1.schema.json"
      }
    },
    "lifecycle": {
      "enum": ["active", "discontinued"]
    },
    "action": {
      "$ref": "card-action.v1.schema.json"
    },
    "modifiedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "detail_product"
          }
        }
      },
      "then": {
        "properties": {
          "publicPath": {
            "$ref": "public-path.schema.json"
          },
          "action": {
            "properties": {
              "mode": {
                "const": "view_product"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "catalog_accessory"
          },
          "lifecycle": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "publicPath": {
            "type": "null"
          },
          "action": {
            "properties": {
              "mode": {
                "const": "direct_rfq"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "catalog_accessory"
          },
          "lifecycle": {
            "const": "discontinued"
          }
        }
      },
      "then": {
        "properties": {
          "publicPath": {
            "type": "null"
          },
          "action": {
            "properties": {
              "mode": {
                "const": "replacement_contact"
              }
            }
          }
        }
      }
    }
  ]
}
