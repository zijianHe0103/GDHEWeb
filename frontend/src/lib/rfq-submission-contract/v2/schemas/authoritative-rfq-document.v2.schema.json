{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authoritative-rfq-document.v2.schema.json",
  "title": "GDHE AuthoritativeRfqDocument 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "rfqId", "publicReference", "receivedAt", "status", "customer", "privacyNotice", "lines", "payloadDigest", "idempotency", "sourceSecurity", "delivery"],
  "properties": {
    "contractVersion": { "const": "2.0.0" },
    "rfqId": { "$ref": "common.v2.schema.json#/$defs/uuidV4" },
    "publicReference": { "$ref": "common.v2.schema.json#/$defs/publicReference" },
    "receivedAt": { "$ref": "common.v2.schema.json#/$defs/utcTimestamp" },
    "status": { "enum": ["idempotency_reserved", "resolving_lines", "delivery_pending", "accepted", "delivery_indeterminate", "rejected_before_delivery"] },
    "customer": { "$ref": "common.v2.schema.json#/$defs/publicCustomer" },
    "privacyNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "presentedAt", "receivedAt"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "presentedAt": { "$ref": "common.v2.schema.json#/$defs/utcTimestamp" },
        "receivedAt": { "$ref": "common.v2.schema.json#/$defs/utcTimestamp" }
      }
    },
    "lines": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "oneOf": [{ "$ref": "#/$defs/configuredStandardLine" }, { "$ref": "#/$defs/configuredCustomLine" }, { "$ref": "#/$defs/catalogAccessoryLine" }] } },
    "payloadDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyVersion", "value"],
      "properties": { "keyVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "value": { "$ref": "common.v2.schema.json#/$defs/hexSha256" } }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyFingerprint", "createdAt", "expiresAt"],
      "properties": {
        "keyFingerprint": { "$ref": "common.v2.schema.json#/$defs/hexSha256" },
        "createdAt": { "$ref": "common.v2.schema.json#/$defs/utcTimestamp" },
        "expiresAt": { "$ref": "common.v2.schema.json#/$defs/utcTimestamp" }
      }
    },
    "sourceSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFingerprint", "outcomeCode"],
      "properties": {
        "sourceFingerprint": { "$ref": "common.v2.schema.json#/$defs/hexSha256" },
        "contactFingerprint": { "$ref": "common.v2.schema.json#/$defs/hexSha256" },
        "outcomeCode": { "const": "new_intent" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "attemptCount", "lastTransitionAt"],
      "properties": {
        "state": { "enum": ["not_started", "pending", "accepted", "indeterminate", "rejected"] },
        "attemptCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "lastTransitionAt": { "$ref": "common.v2.schema.json#/$defs/utcTimestamp" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/stateReserved" },
    { "$ref": "#/$defs/stateResolving" },
    { "$ref": "#/$defs/statePending" },
    { "$ref": "#/$defs/stateAccepted" },
    { "$ref": "#/$defs/stateIndeterminate" },
    { "$ref": "#/$defs/stateRejected" }
  ],
  "$defs": {
    "stateReserved": { "type": "object", "properties": { "status": { "const": "idempotency_reserved" }, "delivery": { "type": "object", "properties": { "state": { "const": "not_started" }, "attemptCount": { "const": 0 } }, "required": ["state", "attemptCount"] } }, "required": ["status", "delivery"] },
    "stateResolving": { "type": "object", "properties": { "status": { "const": "resolving_lines" }, "delivery": { "type": "object", "properties": { "state": { "const": "not_started" }, "attemptCount": { "const": 0 } }, "required": ["state", "attemptCount"] } }, "required": ["status", "delivery"] },
    "statePending": { "type": "object", "properties": { "status": { "const": "delivery_pending" }, "delivery": { "type": "object", "properties": { "state": { "const": "pending" }, "attemptCount": { "const": 1 } }, "required": ["state", "attemptCount"] } }, "required": ["status", "delivery"] },
    "stateAccepted": { "type": "object", "properties": { "status": { "const": "accepted" }, "delivery": { "type": "object", "properties": { "state": { "const": "accepted" }, "attemptCount": { "const": 1 } }, "required": ["state", "attemptCount"] } }, "required": ["status", "delivery"] },
    "stateIndeterminate": { "type": "object", "properties": { "status": { "const": "delivery_indeterminate" }, "delivery": { "type": "object", "properties": { "state": { "const": "indeterminate" }, "attemptCount": { "const": 1 } }, "required": ["state", "attemptCount"] } }, "required": ["status", "delivery"] },
    "stateRejected": { "type": "object", "properties": { "status": { "const": "rejected_before_delivery" }, "delivery": { "type": "object", "properties": { "state": { "const": "rejected" }, "attemptCount": { "const": 0 } }, "required": ["state", "attemptCount"] } }, "required": ["status", "delivery"] },
    "configuredBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "lineKind", "resolution", "model", "publicPath", "articleNumber", "selection", "packaging", "quantityUnit", "quantity"],
      "properties": {
        "entryId": { "$ref": "common.v2.schema.json#/$defs/uuidV4" },
        "lineKind": { "const": "configured_product" },
        "resolution": { "enum": ["resolved_article_number", "sales_follow_up"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "publicPath": { "$ref": "common.v2.schema.json#/$defs/publicPath" },
        "articleNumber": { "type": ["string", "null"], "pattern": "^GDHEPRD[0-9]{6}$" },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "articleNumber", "lengthMeters", "color"],
          "properties": {
            "type": { "enum": ["article_number", "custom_length"] },
            "articleNumber": { "type": ["string", "null"], "pattern": "^GDHEPRD[0-9]{6}$" },
            "lengthMeters": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.1 },
            "color": { "$ref": "common.v2.schema.json#/$defs/color" }
          }
        },
        "packaging": { "$ref": "common.v2.schema.json#/$defs/packaging" },
        "quantityUnit": { "const": "piece" },
        "quantity": { "$ref": "common.v2.schema.json#/$defs/positiveSafeInteger" },
        "followUpReason": { "const": "custom_length" }
      }
    },
    "configuredStandardLine": {
      "allOf": [
        { "$ref": "#/$defs/configuredBase" },
        {
          "type": "object",
          "properties": {
            "resolution": { "const": "resolved_article_number" },
            "articleNumber": { "$ref": "common.v2.schema.json#/$defs/articleNumber" },
            "selection": { "type": "object", "properties": { "type": { "const": "article_number" }, "articleNumber": { "$ref": "common.v2.schema.json#/$defs/articleNumber" } }, "required": ["type", "articleNumber"] }
          },
          "not": { "type": "object", "properties": { "followUpReason": true }, "required": ["followUpReason"] }
        }
      ]
    },
    "configuredCustomLine": {
      "allOf": [
        { "$ref": "#/$defs/configuredBase" },
        {
          "type": "object",
          "required": ["followUpReason"],
          "properties": {
            "resolution": { "const": "sales_follow_up" },
            "articleNumber": { "type": "null" },
            "selection": { "type": "object", "properties": { "type": { "const": "custom_length" }, "articleNumber": { "type": "null" } }, "required": ["type", "articleNumber"] },
            "followUpReason": { "const": "custom_length" }
          }
        }
      ]
    },
    "catalogAccessoryLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "lineKind", "resolution", "model", "publicPath", "articleNumber", "quantityUnit", "quantity"],
      "properties": {
        "entryId": { "$ref": "common.v2.schema.json#/$defs/uuidV4" },
        "lineKind": { "const": "catalog_accessory" },
        "resolution": { "const": "resolved_article_number" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "publicPath": { "type": "null" },
        "articleNumber": { "$ref": "common.v2.schema.json#/$defs/articleNumber" },
        "quantityUnit": { "const": "piece" },
        "quantity": { "$ref": "common.v2.schema.json#/$defs/positiveSafeInteger" }
      }
    }
  }
}
