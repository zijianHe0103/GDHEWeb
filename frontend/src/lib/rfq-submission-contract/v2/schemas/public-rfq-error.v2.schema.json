{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public-rfq-error.v2.schema.json",
  "title": "GDHE PublicRfqError 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "error"],
  "properties": {
    "contractVersion": { "const": "2.0.0" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "requestReference", "messageKey"],
      "properties": {
        "code": { "enum": ["invalid_request", "invalid_submission_intent", "request_not_allowed", "challenge_required_or_invalid", "rate_limited", "unsupported_media_type", "payload_too_large", "basket_too_large_to_submit", "invalid_customer_fields", "invalid_line_count", "invalid_quantity", "basket_refresh_required", "product_unavailable", "configuration_changed", "idempotency_conflict", "service_temporarily_unavailable"] },
        "requestReference": { "$ref": "common.v2.schema.json#/$defs/requestReference" },
        "messageKey": { "type": "string", "pattern": "^rfq\\.error\\.[a-z_]+$" },
        "fieldErrors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["field", "code"], "properties": { "field": { "enum": ["fullName", "companyName", "whatsApp", "weChat", "businessEmail", "phone", "countryRegion", "city", "companyWebsite", "message", "contactMethods", "privacyNotice"] }, "code": { "enum": ["required", "invalid", "too_long", "at_least_one_required"] } } },
              { "type": "object", "additionalProperties": false, "required": ["field", "code"], "properties": { "field": { "enum": ["basket", "lineCount"] }, "code": { "enum": ["required", "invalid", "expired", "changed", "unavailable"] } } },
              { "type": "object", "additionalProperties": false, "required": ["field", "code", "entryId"], "properties": { "field": { "enum": ["quantity", "selection", "packaging"] }, "code": { "enum": ["invalid", "changed", "unavailable"] }, "entryId": { "$ref": "common.v2.schema.json#/$defs/uuidV4" } } }
            ]
          }
        },
        "retryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}
