# Durable Project Governance 命令策略示例。
# Rules 是实验性辅助防线，不是唯一执行边界。

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Durable Project Governance 禁止 force push。",
    match = [
        "git push --force",
        "git push --force origin codex/task-TASK-001-demo",
    ],
    not_match = [
        "git push origin codex/task-TASK-001-demo",
    ],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Durable Project Governance 禁止 force push。",
    match = [
        "git push -f",
    ],
    not_match = [
        "git push origin codex/task-TASK-001-demo",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Durable Project Governance 禁止 reset --hard。",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset --soft HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "forbidden",
    justification = "Durable Project Governance 禁止自动删除分支。",
    match = [
        "git branch -D codex/task-TASK-001-demo",
    ],
    not_match = [
        "git branch --show-current",
    ],
)

prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "forbidden",
    justification = "Durable Project Governance 禁止自动删除 worktree。",
    match = [
        "git worktree remove ../repo-task",
    ],
    not_match = [
        "git worktree list",
    ],
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "Durable Project Governance 禁止 rebase 未知历史。",
    match = [
        "git rebase main",
    ],
    not_match = [
        "git status --short",
    ],
)
